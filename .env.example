# Copy to .env and fill in.
DATABASE_URL="postgresql://pmd:CHANGE_ME@localhost:5432/pmd?schema=public"

# A long random string, e.g. output of: openssl rand -hex 32
SESSION_SECRET=""

PORT=3000
NODE_ENV=production

# Set to 1 when the app is served over HTTPS (secure cookies).
COOKIE_SECURE=0
# Set to 1 when running behind a reverse proxy such as nginx.
TRUST_PROXY=0

# Where uploaded photos and documents are stored.
UPLOAD_DIR=/var/lib/pmd/uploads

# Starting password for the seeded demo users (change after first sign-in).
SEED_PASSWORD=""
# Set to 0 on the production server to skip the sample registers.
SEED_SAMPLE=1
