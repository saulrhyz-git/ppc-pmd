# Copy to .env and fill in.
DATABASE_URL="postgresql://pmd:CHANGE_ME@localhost:5432/pmd?schema=public"

# A long random string, e.g. output of: openssl rand -hex 32
SESSION_SECRET=""

PORT=3000
NODE_ENV=production

# Set to 1 when the app is served over HTTPS (secure cookies).
COOKIE_SECURE=0
# Set to 1 when running behind a reverse proxy such as nginx.
TRUST_PROXY=0

# Where uploaded photos and documents are stored.
UPLOAD_DIR=/var/lib/pmd/uploads

# Starting password for the seeded demo users (change after first sign-in).
SEED_PASSWORD=""
# Set to 0 on the production server to skip the sample registers.
SEED_SAMPLE=1

# ---- Owner / tenant portal (https://<your domain>/myportal) ----
# Public address of the site, used in invitation links, e.g. https://example.com (no /myportal; defaults to the address staff use).
PORTAL_PUBLIC_URL=""
# Key for encrypting two-step secrets. Defaults to SESSION_SECRET; set its own 32+ character value in production.
PORTAL_SECRET=""
# 1 = every portal account must turn on two-step sign-in before seeing anything.
PORTAL_REQUIRE_MFA=0
# Sign-out after this many idle minutes / this many hours in total.
PORTAL_IDLE_MINUTES=30
PORTAL_MAX_HOURS=12
# How long invitation and reset links work.
PORTAL_INVITE_HOURS=72
PORTAL_RESET_HOURS=24
